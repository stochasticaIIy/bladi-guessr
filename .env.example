# Secret used to sign the game cookie. Required in production.
# Generate one with: openssl rand -hex 32
GAME_SECRET=

# Mapillary client token — the game streams its street-level imagery.
# Free, no card: https://www.mapillary.com/dashboard/developers -> Register application
# This one is public by design (it is read in the browser). Without it, the
# street mode is disabled on the intro; the still-photo mode needs no token
# and stays fully playable.
NEXT_PUBLIC_MAPILLARY_TOKEN=

# Only needed by `npm run scan`, which rebuilds data/panoramas.json from the
# coverage tiles. A client token works; it never reaches the browser.
MAPILLARY_TOKEN=

# Shared leaderboard storage, on JSONBin (https://jsonbin.io).
# Server-side only — do NOT prefix either with NEXT_PUBLIC_: the master key can
# read and write every bin on your account.
# Set both to switch the leaderboard on; leave them empty and the game simply
# hides it. Create a bin and copy its id from the dashboard.
JSONBIN_BIN_ID=
# `.env` files expand `$`, and JSONBin keys contain several, so escape them:
#   JSONBIN_MASTER_KEY=\$2a\$10\$...
# In the Vercel/hosting dashboard paste the key as-is (no escaping there).
JSONBIN_MASTER_KEY=
